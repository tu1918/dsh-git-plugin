# The session sandbox is workspace-write, so npm's default cache (~/.npm) is not
# writable here. Keep every npm artifact inside the workspace instead.
cache=.tooling/npm-cache
fund=false
audit=false
# The @deepseek-ai packages are pinned to 0.1.5-rc.1 so the published types
# match the DSH build actually running in production here. Their own transitive
# peers resolve forward to 0.1.5-rc.2, which npm then refuses; the conflict is
# purely between type-only devDependencies we never ship, so accept it.
legacy-peer-deps=true
