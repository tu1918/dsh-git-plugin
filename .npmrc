# The session sandbox is workspace-write, so npm's default cache (~/.npm) is not
# writable here. Keep every npm artifact inside the workspace instead.
cache=.tooling/npm-cache
fund=false
audit=false
# The @deepseek-ai packages are pinned to 0.2.0-rc.2 so the published types
# match the DSH build actually running in production here. The `legacy-peer-deps`
# this file needed through 0.1.5-rc.1 is gone with that release: its transitive
# peers then resolved forward to a version npm refused, while at 0.2.0-rc.2 the
# whole tree resolves to one version per package.
